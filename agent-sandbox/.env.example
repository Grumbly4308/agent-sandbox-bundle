# Copy to .env, chmod 600, fill in. NEVER commit .env.
# `./sandbox init` does this for you and fills in your uid/gid.

# --- Identity of this sandbox -----------------------------------------------
# Container and network names are prefixed with this, so several copies of the
# bundle (one per project) can run at the same time without colliding.
# `./sandbox` fills it in from the directory name if you leave it empty.
SANDBOX_NAME=agent-sandbox

# --- Container runtime ------------------------------------------------------
# `podman` (default) or `docker`. Empty = whichever is installed, podman first.
# Rootless Podman has no root daemon, so a container escape lands in an
# unprivileged account rather than on the host as root. See docs/11-podman.md.
SANDBOX_RUNTIME=podman

# Which compose implementation drives Podman. Empty = podman-compose if it is
# installed, else `podman compose`.
#   podman-compose    native, drives the podman CLI, needs no socket
#   "podman compose"  dispatcher; delegates to the docker-compose plugin, which
#                     requires the podman API socket to be running
SANDBOX_COMPOSE=

# Podman user namespace. Empty/anything = apply keep-id so agent-written files
# come back owned by you. `off` = skip it, needed only if your podman-compose
# is too old for --in-pod=false (a pod owns its own userns, so the two clash:
# "Error: --userns and --pod cannot be set together"). With it off, repair
# ownership afterwards:  podman unshare chown -R 0:0 workspace
SANDBOX_USERNS=

# --- Privilege check --------------------------------------------------------
# `./sandbox` warns if the account running it can become root (passwordless
# sudo, membership of sudo/wheel/admin, or the docker group). A sandbox whose
# escape lands somewhere that can reach root is mostly decoration. Set to 1 to
# accept that and silence the warning.
SANDBOX_ALLOW_PRIVILEGED=

# --- Model API --------------------------------------------------------------
# Use a SEPARATE key with its own spend limit, not your personal one.
# A runaway loop should be able to burn a budget you chose, and nothing more.
ANTHROPIC_API_KEY=

# Alternative to an API key: a long-lived OAuth token, if your CLI version
# provides one (try `claude setup-token`). Leave empty to log in interactively
# with `./sandbox login`, which saves the session under auth/ instead.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Git push access --------------------------------------------------------
# GitHub: fine-grained PAT, ONE repository, Contents: read/write, expires in
#   1 day. Settings > Developer settings > Fine-grained tokens.
# GitLab: project access token, scope `write_repository`, expiry tomorrow.
# Leave empty if you push from the host instead (recommended — ./sandbox push).
GIT_TOKEN=

GIT_AUTHOR_NAME=agent
GIT_AUTHOR_EMAIL=agent@sandbox.local

# --- Self-hosted git over SSH -----------------------------------------------
# Only needed if you mount a deploy key AND your server is not github.com or
# gitlab.com. The proxy can only CONNECT to ports in its SSH_ports ACL, so a
# non-443 port also needs an edit to proxy/squid.conf. See docs/06.
GIT_SSH_HOST=
GIT_SSH_PORT=443

# --- Container identity -----------------------------------------------------
# MANAGED AUTOMATICALLY. `./sandbox` takes these from `id -u` / `id -g` on every
# run, exports them for compose, and rewrites them here if they disagree — so
# copying this bundle to another machine or account just works. Edit only if
# you deliberately want the container to run as a different uid.
HOST_UID=1000
HOST_GID=1000

# --- Which agent ------------------------------------------------------------
# npm package installed into the image. Examples:
#   @anthropic-ai/claude-code           (default; `claude` on PATH)
#   @anthropic-ai/claude-code@2.1.223   pinned — reproducible builds
#   opencode-ai
# For a pip-based agent, edit agent/Dockerfile instead.
#
# In-container auto-update is off (read-only rootfs, non-root user, container
# discarded on exit), so the image IS the version. Move it forward with
# `./sandbox upgrade`, which rebuilds without cache.
AGENT_CLI=@anthropic-ai/claude-code

# --- Resource ceilings ------------------------------------------------------
AGENT_MEMORY=4g
AGENT_CPUS=2
